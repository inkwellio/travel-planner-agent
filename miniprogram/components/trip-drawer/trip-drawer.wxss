@import "../../theme.wxss";

.host { display: flex; width: 100%; height: 100%; }
.panel {
  width: 80vw;
  flex-shrink: 0;
  max-width: 600rpx;
  height: 100%;
  background: var(--paper);
  border-right: 1px solid var(--primary);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.dim { flex: 1; background: var(--dim); }
.pad { padding: 32rpx 32rpx 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.title { font-size: 32rpx; line-height: 48rpx; color: var(--ink); }
.sub { font-size: 22rpx; line-height: 32rpx; color: var(--muted); }
.create {
  height: 80rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.search {
  height: 80rpx;
  border-radius: 999rpx;
  border: 1px solid var(--line);
  background: var(--low);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  gap: 12rpx;
}
.search-input { flex: 1; height: 80rpx; font-size: 26rpx; color: var(--ink); }
.ph { color: var(--muted); }
.list { flex: 1; height: 0; min-height: 0; padding: 8rpx 24rpx 16rpx; box-sizing: border-box; }
.blank { padding: 32rpx 16rpx; }
.blank-title { font-size: 26rpx; color: var(--sub); }
.blank-sub { margin-top: 8rpx; font-size: 22rpx; color: var(--muted); }
.group { margin-bottom: 24rpx; }
.bucket { padding: 8rpx 16rpx; font-size: 22rpx; letter-spacing: 0.08em; color: var(--muted); font-weight: 600; }
.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 32rpx;
}
.row.on { background: var(--chip); }
.meta { flex: 1; min-width: 0; }
.name { font-family: var(--serif); font-size: 30rpx; line-height: 40rpx; color: var(--ink); }
.stamp { margin-top: 4rpx; font-size: 22rpx; color: var(--sub); }
.ask { display: flex; gap: 8rpx; margin-top: 8rpx; }
.yes, .no { height: 48rpx; padding: 0 16rpx; border-radius: 999rpx; font-size: 22rpx; line-height: 48rpx; }
.yes { background: var(--error); color: #fff; }
.yes.dis { opacity: 0.5; }
.no { border: 1px solid var(--line); color: var(--sub); }
.side { display: flex; align-items: center; gap: 8rpx; flex-shrink: 0; }
.ver {
  padding: 0 12rpx;
  height: 36rpx;
  border-radius: 999rpx;
  border: 1px solid var(--line);
  background: var(--paper);
  font-size: 20rpx;
  line-height: 36rpx;
  color: var(--sub);
}
.dot { width: 12rpx; height: 12rpx; border-radius: 999rpx; background: var(--accent); }
.del {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.foot {
  border-top: 1px solid var(--line);
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.mode { flex: 1; min-width: 0; font-size: 20rpx; color: var(--muted); }
.privacy { font-size: 22rpx; color: var(--primary); flex-shrink: 0; }
