@import "../../theme.wxss";

.host { display: block; position: relative; z-index: 5; background: var(--low); border-bottom: 1px solid var(--line); }
.off { opacity: 0.6; }
.chips { width: 100%; height: 112rpx; white-space: nowrap; }
.row { display: inline-flex; align-items: center; height: 112rpx; padding: 0 32rpx; }
.label { font-size: 22rpx; color: var(--muted); margin-right: 16rpx; }
.chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 64rpx;
  padding: 0 24rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  border: 1px solid var(--line);
  background: var(--paper);
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 500;
}
.chip.primary { background: var(--chip); color: var(--primary); border-color: var(--primary); font-weight: 600; }
.chip.elder { border-color: var(--accent); }
.chip.hot { border-color: var(--primary); }
.pop {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 100%;
  margin-top: 8rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: var(--paper);
  border: 1px solid var(--line);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  z-index: 30;
}
.field {
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 40rpx;
  border: 1px solid var(--line);
  background: var(--bg);
  font-size: 26rpx;
  color: var(--ink);
}
.ph { color: var(--muted); }
.opt {
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1px solid var(--line);
  background: var(--paper);
  font-size: 26rpx;
  line-height: 64rpx;
  color: var(--ink);
}
.opt.on { background: var(--primary); border-color: var(--primary); color: #fff; }
.done { margin-left: auto; color: var(--primary); font-size: 26rpx; font-weight: 500; padding: 8rpx; }
