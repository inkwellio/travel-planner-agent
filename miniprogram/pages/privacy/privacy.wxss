@import "../../theme.wxss";

.page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  color: var(--ink);
  box-sizing: border-box;
}
.h1 { font-size: 40rpx; line-height: 56rpx; margin-bottom: 24rpx; }
.h2 { margin-top: 36rpx; font-size: 30rpx; line-height: 44rpx; font-weight: 600; }
.p { margin-top: 12rpx; font-size: 28rpx; line-height: 44rpx; color: var(--sub); }
