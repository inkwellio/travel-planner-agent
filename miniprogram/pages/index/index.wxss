@import "../../theme.wxss";

.app { height: 100vh; background: var(--bg); color: var(--ink); }
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--paper);
  border-bottom: 1px solid var(--line);
  box-sizing: border-box;
}
.header-row { height: 100%; display: flex; align-items: center; gap: 12rpx; padding-left: 8rpx; }
.brand-btn, .brand {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.brand-logo { display: block; width: 64rpx; height: 64rpx; }
.tabs { margin-left: auto; display: flex; gap: 8rpx; flex-shrink: 0; }
.tab {
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 56rpx;
  color: var(--sub);
  white-space: nowrap;
}
.tab.on { background: var(--primary); color: #fff; }

.stage {
  position: fixed;
  left: 0;
  right: 0;
  display: flex;
  flex-direction: column;
  background: var(--paper);
}
.center { flex: 1; display: flex; align-items: center; justify-content: center; color: var(--muted); padding: 48rpx; text-align: center; }
.col { flex-direction: column; gap: 24rpx; }
.err { font-size: 28rpx; line-height: 44rpx; color: var(--sub); }
.retry {
  height: 80rpx;
  padding: 0 40rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  line-height: 80rpx;
  font-weight: 600;
}
.offline {
  padding: 16rpx 32rpx;
  background: var(--error-bg);
  color: var(--error);
  font-size: 24rpx;
  line-height: 36rpx;
}
.chat { flex: 1; height: 0; min-height: 0; }
.chat-inner { padding: 32rpx 32rpx 24rpx; display: flex; flex-direction: column; gap: 40rpx; }
.user-row { display: flex; justify-content: flex-end; padding-left: 64rpx; }
.user-bubble {
  max-width: 100%;
  padding: 24rpx 32rpx;
  border-radius: 32rpx;
  border-top-right-radius: 8rpx;
  background: var(--chip);
  color: var(--ink);
  font-size: 28rpx;
  line-height: 44rpx;
}
.bot-row { display: flex; gap: 16rpx; align-items: flex-start; }
.avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: var(--primary);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bot-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 12rpx; }
.who { display: flex; align-items: center; gap: 12rpx; min-height: 56rpx; }
.who-name { font-size: 32rpx; line-height: 44rpx; }
.badge {
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  border: 1px solid var(--line);
  color: var(--muted);
  font-size: 20rpx;
  line-height: 40rpx;
  letter-spacing: 0.04em;
}
.bot-bubble {
  padding: 28rpx 32rpx;
  border-radius: 32rpx;
  border-top-left-radius: 8rpx;
  background: var(--low);
  border: 1px solid var(--line);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.bot-text { font-size: 28rpx; line-height: 44rpx; color: var(--ink); }
.cards { display: flex; flex-direction: column; gap: 20rpx; }
.actions { display: flex; flex-wrap: wrap; gap: 16rpx; }
.go, .ghost, .btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
}
.go {
  height: 80rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}
.generate-bar { flex-shrink: 0; padding: 12rpx 32rpx; background: var(--paper); border-top: 1px solid var(--line); }
.generate-btn { width: 100%; justify-content: center; }
.ghost {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 40rpx;
  border: 1px solid var(--line);
  background: var(--paper);
  color: var(--ink);
  font-size: 26rpx;
}
.dis { opacity: 0.5; }
.thinking { display: flex; align-items: center; gap: 16rpx; }
.thinking-text { color: var(--muted); font-size: 26rpx; }
.anchor { height: 1px; }

.sheet-body { flex: 1; height: 0; min-height: 0; }
.sheet-inner {
  padding: 8rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.overview, .map-card {
  border: 1px solid var(--line);
  border-radius: 32rpx;
  padding: 32rpx;
  background: var(--paper);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.overview-head, .map-title, .map-head { display: flex; align-items: center; gap: 12rpx; }
.map-head { justify-content: space-between; flex-wrap: wrap; }
.overview-title, .map-title { font-size: 28rpx; font-weight: 600; }
.km { font-size: 22rpx; color: var(--muted); }
.lake-wrap {
  position: relative;
  min-height: 320rpx;
  border-radius: 32rpx;
  background: var(--low);
  border: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
}
.lake { width: 280rpx; height: 200rpx; border-radius: 50%; background: var(--chip); }
.lake-label { position: absolute; color: var(--primary); font-size: 28rpx; }
.overview-hint { text-align: center; color: var(--sub); font-size: 28rpx; line-height: 44rpx; }
.map { width: 100%; height: 360rpx; border-radius: 32rpx; }
.result-head, .result-actions { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; }
.result-title { font-size: 32rpx; line-height: 44rpx; }
.ver-pill, .elder, .btn {
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 1px solid var(--line);
  background: var(--paper);
  font-size: 24rpx;
  color: var(--sub);
}
.ver-pill, .elder, .btn { display: inline-flex; align-items: center; gap: 6rpx; }
.elder { background: var(--primary-fixed); color: var(--primary); font-weight: 600; border-radius: 999rpx; }
.btn { height: 80rpx; border-radius: 40rpx; color: var(--ink); font-size: 26rpx; font-weight: 600; }
.btn.solid { background: var(--primary); color: #fff; border-color: var(--primary); border-radius: 999rpx; }
.stream, .alert {
  display: flex;
  gap: 12rpx;
  align-items: flex-start;
  padding: 20rpx 24rpx;
  border-radius: 32rpx;
  border: 1px solid var(--line);
  font-size: 26rpx;
  line-height: 40rpx;
}
.stream { background: var(--primary-fixed); color: var(--on-sec); }
.alert { background: var(--secondary-fixed); color: var(--ink); }
.alert-main { flex: 1; min-width: 0; }
.alert-top { display: flex; justify-content: space-between; gap: 12rpx; flex-wrap: wrap; }
.alert-title { color: var(--accent); font-weight: 600; font-size: 28rpx; }
.alert-text { margin-top: 6rpx; color: var(--sub); font-size: 26rpx; }
.alert-meta {
  margin-top: 8rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: 1px solid var(--line);
  color: var(--muted);
  font-size: 22rpx;
  line-height: 48rpx;
}
.ref.muted {
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: #DCE4E1;
  color: var(--muted);
  font-size: 20rpx;
  line-height: 32rpx;
}
.day-tabs { width: 100%; white-space: nowrap; }
.day-row { display: inline-flex; gap: 12rpx; padding: 4rpx 0; }
.day {
  height: 72rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 1px solid var(--line);
  background: var(--paper);
  color: var(--sub);
  font-size: 26rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
}
.day.on { background: var(--primary); border-color: var(--primary); color: #fff; }
.summary { font-size: 26rpx; line-height: 40rpx; color: var(--sub); }
.drag-hint { font-size: 22rpx; color: var(--muted); }
.sk { display: flex; flex-direction: column; gap: 20rpx; }
.sk-title { display: flex; align-items: center; gap: 8rpx; color: var(--primary); font-size: 26rpx; }
.sk-row { display: flex; gap: 16rpx; }
.sk-num {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: var(--chip);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 26rpx;
}
.sk-card { flex: 1; border: 1px solid var(--line); border-radius: 32rpx; padding: 24rpx; background: var(--paper); }
.sk-name { font-family: var(--serif); font-size: 30rpx; margin-bottom: 12rpx; }
.sk-bar { height: 16rpx; border-radius: 8rpx; background: var(--chip); margin-top: 10rpx; }
.w1 { width: 75%; }
.w2 { width: 50%; }

.drawer { position: fixed; left: 0; right: 0; bottom: 0; z-index: 70; display: flex; }
.toast {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(46, 53, 50, 0.28);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}
.toast-card {
  width: 100%;
  background: var(--paper);
  border: 1px solid var(--line);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: env(safe-area-inset-bottom);
}
.toast-title { font-family: var(--serif); font-size: 32rpx; }
.toast-url { display: block; margin-top: 16rpx; font-size: 26rpx; line-height: 40rpx; color: var(--primary); word-break: break-all; }
.toast-tip { margin-top: 12rpx; font-size: 22rpx; color: var(--muted); }
.toast-btn {
  margin-top: 24rpx;
  height: 80rpx;
  border-radius: 999rpx;
  background: var(--primary);
  color: #fff;
  text-align: center;
  line-height: 80rpx;
  font-weight: 600;
}

.export-canvas { position: fixed; left: -2000px; top: 0; pointer-events: none; }
