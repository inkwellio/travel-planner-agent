# ===== 后端（复制为仓库根目录 .env；server 读取） =====
# DeepSeek（OpenAI 兼容）。聊天语义理解和景点匹配需要配置；留空时明确提示不可用，不按关键词猜测
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 高德 Web 服务 key（仅后端）。留空则 MockProvider + 本地示例景点库
AMAP_WEB_KEY=
# 高德 JS API 安全密钥：只放后端，由 /_AMapService 代理拼接 jscode
AMAP_SECURITY_CODE=
# 网页搜索（旅行问题与景点补充资料）：bocha | tavily。留空则不搜索。
SEARCH_PROVIDER=bocha
SEARCH_API_KEY=
# SQLite 文件（LangGraph checkpoint + 景点资料库），相对 server/ 目录
DB_PATH=data/travel.db
PORT=8787
# 限流：规划/聊天类接口每 IP 每分钟上限。dev 默认 60，production 默认 5；0=不限
# 所有公开 API 和地图代理每 IP 每分钟上限：dev 默认 600，production 默认 120；0=不限
PUBLIC_RATE_LIMIT_PER_MIN=
RATE_LIMIT_PER_MIN=
# 每日全局外部调用上限（分别计数，Asia/Taipei 自然日）。dev 默认不限，production 默认 2000/5000/500；0=不限
DAILY_LIMIT_DEEPSEEK=
DAILY_LIMIT_AMAP=
DAILY_LIMIT_SEARCH=
# 反向代理后取真实 IP（Express trust proxy），默认 loopback
TRUST_PROXY=
# 可选：覆盖 server/src/config/admin.ts 中的初始管理员账号。
# 留空使用配置文件中的账号和初始密码；仅限服务端，不要加 VITE_ 前缀。
ADMIN_PHONE=
ADMIN_PASSWORD=

# ===== 前端（Vite 读取根目录 .env 中 VITE_*） =====
# 高德 JS API key（只需 key；安全密钥走后端代理）。留空显示静态占位地图
VITE_AMAP_JS_KEY=
